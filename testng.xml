<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="MediShield Test Suite" parallel="false">
    
    <listeners>
        <listener class-name="com.medishield.listeners.TestListener" />
    </listeners>

    <test name="Selenium UI Tests">
        <parameter name="browser" value="chrome" />
        <parameter name="headless" value="true" />
        <classes>
            <class name="com.medishield.selenium.SeleniumUITest" />
        </classes>
    </test>
</suite>
