# MediShield AI - Backend Environment Variables Template

PORT=5000

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=medishield
DB_USER=root
DB_PASS=your_mysql_password_here

# JWT Configuration
JWT_SECRET=your_jwt_secret_here

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# OCR.space API Key for prescription scanner (optional fallback)
OCR_API_KEY=your_ocr_api_key_here

# Permitted Frontend Origin for CORS (comma-separated for multiple origins)
FRONTEND_URL=http://localhost:5173,http://localhost:3000
